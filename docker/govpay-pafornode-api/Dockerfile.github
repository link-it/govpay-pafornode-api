FROM eclipse-temurin:25-jre-alpine

ARG govpay_pafornode_api_fullversion
# sha256 del jar della release: la pipeline lo calcola dall'artifact della
# build, build_image.sh lo legge dalle API delle release di GitHub.
ARG govpay_pafornode_api_sha256
ARG govpay_pafornode_api_home=/opt/govpay-pafornode
ARG govpay_pafornode_api_log=/var/log/govpay-pafornode

LABEL maintainer="Link.it s.r.l."
LABEL description="GovPay PaForNode SOAP API"
LABEL govpay.pafornode.version="${govpay_pafornode_api_fullversion}"
USER root

ENV GOVPAY_PAFORNODE_FULLVERSION=${govpay_pafornode_api_fullversion} \
GOVPAY_PAFORNODE_LOGDIR=${govpay_pafornode_api_log} \
GOVPAY_PAFORNODE_HOME=${govpay_pafornode_api_home} \
TZ=Europe/Rome


RUN set -eux; \
apk update; \
apk upgrade; \
# Solo cio' che serve a runtime: bash per l'entrypoint, tzdata per il fuso
# orario. tar, unzip, netcat e curl non sono usati dall'entrypoint, e ogni
# pacchetto in piu' e' superficie esposta e segnalazioni della scansione.
apk add --no-cache bash tzdata; \
rm -rf /var/cache/apk/*; \
echo "${TZ}" > /etc/timezone; \
addgroup -S govpay ; \
adduser -S -G govpay govpay; \
mkdir -p ${GOVPAY_PAFORNODE_HOME} ${GOVPAY_PAFORNODE_LOGDIR}; \
chown -R govpay:govpay ${GOVPAY_PAFORNODE_HOME} ${GOVPAY_PAFORNODE_LOGDIR}

WORKDIR ${GOVPAY_PAFORNODE_HOME}

# Download del jar dalla release GitHub, con verifica del certificato e del
# checksum: senza checksum l'immagine conterrebbe qualunque file venisse
# servito a quell'indirizzo. curl serve solo qui: installato e rimosso nello
# stesso passo, non resta nell'immagine.
RUN set -eux; \
apk add --no-cache --virtual .download curl; \
test -n "${govpay_pafornode_api_sha256}" || { echo "Manca il build-arg govpay_pafornode_api_sha256 (sha256 del jar della release)"; exit 1; }; \
curl -fL -sS -o /opt/govpay-pafornode/govpay-pafornode-api.jar "https://github.com/link-it/govpay-pafornode-api/releases/download/${GOVPAY_PAFORNODE_FULLVERSION}/govpay-pafornode-api-${GOVPAY_PAFORNODE_FULLVERSION}.jar"; \
echo "${govpay_pafornode_api_sha256}  /opt/govpay-pafornode/govpay-pafornode-api.jar" | sha256sum -c -; \
apk del .download


# Copy entrypoint and initialization scripts
COPY commons/entrypoint.sh /usr/local/bin/
RUN chown -R govpay:0 /usr/local/bin/entrypoint.sh ${GOVPAY_PAFORNODE_HOME} ${GOVPAY_PAFORNODE_LOGDIR} \
&& chmod -Rf g+rwX ${GOVPAY_PAFORNODE_HOME} ${GOVPAY_PAFORNODE_LOGDIR} \
&& chmod ug=rx /usr/local/bin/entrypoint.sh



USER govpay

ENV LOGGING_FILE_NAME=${GOVPAY_PAFORNODE_LOGDIR}/govpay-pafornode-api.log \
    LOGGING_DIRECTORYPATH=${GOVPAY_PAFORNODE_LOGDIR} \
    LOGGING_FILEPREFIX=govpay-pafornode-api


ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
